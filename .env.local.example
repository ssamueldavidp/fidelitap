# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxx...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Requerido — sin esta variable, ACTIVAR UNA TARJETA (el flujo central del
# producto) falla con un error 500 (src/lib/wallet/hmac.ts firma unique_code
# con esta clave). Generar con: openssl rand -hex 32
APP_HMAC_SECRET=

# MercadoPago (pagos / planes) — usar credenciales TEST-... en sandbox
MP_ACCESS_TOKEN=TEST-...
MP_WEBHOOK_SECRET=

# Apple Wallet — nombres EXACTOS que lee src/lib/wallet/apple.ts /
# src/app/api/wallet/apple/**. Certificados en base64: `base64 -i archivo.pem`
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=
APPLE_WWDR_BASE64=
APPLE_CERT_BASE64=
APPLE_KEY_BASE64=
APPLE_CERT_PASSPHRASE=

# Apple Wallet push (actualización en vivo del pass) — certificado de push
# del Pass Type ID, DISTINTO del certificado de firma de arriba
# (src/lib/wallet/apns.ts). Sin esto, los passes ya agregados a Wallet no
# se refrescan solos al sumar un sello (el usuario tiene que abrir la app).
APPLE_APN_KEY_BASE64=
APPLE_APN_KEY_ID=

# Google Wallet — nombres EXACTOS que lee src/lib/wallet/google.ts
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=

# Resend (emails transaccionales, Plan 3+)
RESEND_API_KEY=re_...

# Web Push (Pro/Premium notifications)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:soporte@fidelitap.co
CRON_SECRET=
